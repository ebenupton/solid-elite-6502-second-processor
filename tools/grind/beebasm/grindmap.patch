diff --git a/src/grindmap.cpp b/src/grindmap.cpp
new file mode 100644
index 0000000..7e8f534
--- /dev/null
+++ b/src/grindmap.cpp
@@ -0,0 +1,46 @@
+#include "grindmap.h"
+#include "sourcecode.h"
+#include "macro.h"
+#include "globaldata.h"
+#include <cstdlib>
+FILE* g_gmap = NULL;
+const SourceCode* g_gsrc = NULL;
+char g_gkind = 'D';
+bool g_gincbin = false;
+void gmap_open()
+{
+	const char* p = getenv( "BEEBASM_GRINDMAP" );
+	if ( p && *p ) g_gmap = fopen( p, "w" );
+}
+bool gmap_on()
+{
+	return g_gmap != NULL && GlobalData::Instance().IsSecondPass();
+}
+static void site( const SourceCode*& s )
+{
+	while ( s && dynamic_cast< const MacroInstance* >( s ) && s->GetParent() )
+		s = s->GetParent();
+}
+void gmap_emit( char kind, int pc, int n )
+{
+	if ( !gmap_on() || !g_gsrc ) return;
+	const SourceCode* s = g_gsrc;
+	site( s );
+	fprintf( g_gmap, "%c\t%d\t%d\t%s\t%d\t%s\t%d\n", kind, pc, n,
+		g_gsrc->GetFilename().c_str(), g_gsrc->GetLineNumber(),
+		s->GetFilename().c_str(), s->GetLineNumber() );
+}
+void gmap_label( const char* name, int pc )
+{
+	if ( !gmap_on() || !g_gsrc ) return;
+	const SourceCode* s = g_gsrc;
+	site( s );
+	fprintf( g_gmap, "L\t%s\t%d\t%s\t%d\n", name, pc, s->GetFilename().c_str(), s->GetLineNumber() );
+}
+void gmap_equ( const char* name, double v )
+{
+	if ( !gmap_on() || !g_gsrc ) return;
+	const SourceCode* s = g_gsrc;
+	site( s );
+	fprintf( g_gmap, "E\t%s\t%.0f\t%s\t%d\n", name, v, s->GetFilename().c_str(), s->GetLineNumber() );
+}
diff --git a/src/grindmap.h b/src/grindmap.h
new file mode 100644
index 0000000..ea5fbef
--- /dev/null
+++ b/src/grindmap.h
@@ -0,0 +1,28 @@
+// grindmap: a per-byte provenance map for tools/grind (elite).
+// Enabled by the environment variable BEEBASM_GRINDMAP=<file>; written on the
+// second pass only.  Records (one per line, tab separated):
+//   I pc n file line sitefile siteline     an instruction of n bytes
+//   D pc n file line sitefile siteline     data bytes (EQUB/EQUW/EQUS/INCBIN/...)
+//   S pc n file line sitefile siteline     SKIP
+//   L name pc file line                    a label definition (.name)
+//   E name value file line                 a numeric symbol assignment (name = expr)
+//   C start end                            CLEAR start, end
+//   O pc                                   ORG
+//   V file start end                       SAVE
+//   B start end dest                       COPYBLOCK
+// file/line is where the statement is (inside a macro body: the macro's file
+// and line); sitefile/siteline is the outermost non-macro source line.
+#ifndef GRINDMAP_H_
+#define GRINDMAP_H_
+#include <cstdio>
+class SourceCode;
+extern FILE* g_gmap;
+extern const SourceCode* g_gsrc;
+extern char g_gkind;
+extern bool g_gincbin;
+void gmap_open();
+bool gmap_on();
+void gmap_emit( char kind, int pc, int n );
+void gmap_label( const char* name, int pc );
+void gmap_equ( const char* name, double v );
+#endif
